<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit en paralelo a nivel de assembly NO; las suites de Testcontainers SQL
         comparten una instancia. La collection fixture serializa por colección. -->
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="8.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.0.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\SmartMenu.API\SmartMenu.API.csproj" />
    <ProjectReference Include="..\..\src\backend\SmartMenu.Application\SmartMenu.Application.csproj" />
    <ProjectReference Include="..\..\src\backend\SmartMenu.Domain\SmartMenu.Domain.csproj" />
    <ProjectReference Include="..\..\src\backend\SmartMenu.Infrastructure\SmartMenu.Infrastructure.csproj" />
  </ItemGroup>

</Project>
