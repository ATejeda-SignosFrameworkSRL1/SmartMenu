# SmartMenu Waiter App - Variables de Entorno
# Copia este archivo a .env.local y configura las URLs según tu entorno

# Para desarrollo local (solo en tu máquina):
NEXT_PUBLIC_API_URL=https://10.0.0.24:5042
NEXT_PUBLIC_WS_URL=https://10.0.0.24:5042

# Para acceso por red local (desde otros dispositivos):
# NEXT_PUBLIC_API_URL=http://192.168.1.100:5041
# NEXT_PUBLIC_WS_URL=http://192.168.1.100:5041

# IMPORTANTE: Para que SignalR funcione desde la IP (no localhost),
# el backend necesita el certificado dev-cert.pfx. Ejecuta UNA VEZ:
#   cd src\backend\SmartMenu.API
#   .\scripts\create-dev-cert.ps1
# Luego reinicia dotnet run.
