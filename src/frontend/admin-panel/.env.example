# SmartMenu Admin Panel - Variables de Entorno
# Copia este archivo a .env.local y configura las URLs según tu entorno

# Para desarrollo local (solo en tu máquina):
NEXT_PUBLIC_API_URL=https://172.31.98.64:5042

# Para acceso por red local (desde otros dispositivos):
# Reemplaza 192.168.1.100 con tu IP local real
# NEXT_PUBLIC_API_URL=http://192.168.1.100:5041

# Para HTTPS (requiere certificado):
# NEXT_PUBLIC_API_URL=https://172.31.98.64:5042
# NEXT_PUBLIC_API_URL=https://192.168.1.100:5042
