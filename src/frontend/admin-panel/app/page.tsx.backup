'use client';

import { useState, useEffect } from 'react';
import { MainLayout } from '@/components/layout/MainLayout';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { LayoutDashboard, Users, ShoppingBag, CreditCard, TrendingUp, Clock, ChefHat, Wine, AlertCircle, DollarSign} from 'lucide-react';
import { cn } from '@/lib/utils';
import { mockOrders, mockTables, getElapsedMinutes } from '@/lib/mock-data';
import Link from 'next/link';

export default function AdminDashboard() {
  const [currentTime, setCurrentTime] = useState(new Date());

  useEffect(() => {
    const timer = setInterval(() => setCurrentTime(new Date()), 1000);
    return () => clearInterval(timer);
  }, []);

  const activeTables = mockTables.filter(t => t.status === 'occupied');
  const availableTables = mockTables.filter(t => t.status === 'available');
  const totalRevenue = mockOrders.reduce((sum, order) => sum + order.total, 0);
  
  const stats = [
    { 
      label: 'Mesas Disponibles', 
      value: availableTables.length.toString(), 
      change: `${availableTables.length}/${mockTables.length}`,
      icon: LayoutDashboard, 
      color: 'text-success',
      bgColor: 'bg-success/10',
      borderColor: 'border-success/30'
    },
    { 
      label: 'Mesas Ocupadas', 
      value: activeTables.length.toString(), 
      change: `${Math.round((activeTables.length / mockTables.length) * 100)}% ocupación`,
      icon: Users, 
      color: 'text-primary',
      bgColor: 'bg-primary/10',
      borderColor: 'border-primary/30'
    },
    { 
      label: 'Pedidos en Cocina', 
      value: mockOrders.filter(o => o.status === 'preparing').length.toString(), 
      change: 'En preparación',
      icon: ChefHat, 
      color: 'text-warning',
      bgColor: 'bg-warning/10',
      borderColor: 'border-warning/30'
    },
    { 
      label: 'Pedidos en Bar', 
      value: '3', 
      change: 'En preparación',
      icon: Wine, 
      color: 'text-info',
      bgColor: 'bg-info/10',
      borderColor: 'border-info/30'
    },
  ];

  const bottomStats = [
    {
      label: 'Órdenes Totales',
      value: '127',
      subtext: 'del turno',
      icon: ShoppingBag,
      color: 'text-primary',
      bgColor: 'bg-primary/10'
    },
    {
      label: 'Ventas del Día',
      value: `$${(45234 + totalRevenue).toLocaleString()}`,
      subtext: '+23% vs ayer',
      icon: DollarSign,
      color: 'text-success',
      bgColor: 'bg-success/10'
    },
    {
      label: 'Ticket Promedio',
      value: '$285.00',
      subtext: 'por orden',
      icon: CreditCard,
      color: 'text-accent',
      bgColor: 'bg-accent/10'
    },
    {
      label: 'Mesas Activas',
      value: activeTables.length.toString(),
      subtext: `${activeTables.length * 3} comensales`,
      icon: Users,
      color: 'text-info',
      bgColor: 'bg-info/10'
    },
  ];

  // Órdenes activas para el dashboard
  const activeOrders = mockOrders.filter(o => ['pending', 'preparing', 'ready'].includes(o.status));

  const getStatusColor = (status: string) => {
    const colors = {
      pending: 'bg-info/10 text-info border-info/20',
      preparing: 'bg-warning/10 text-warning border-warning/20',
      ready: 'bg-success/10 text-success border-success/20',
    };
    return colors[status as keyof typeof colors] || 'bg-muted';
  };

  const getStatusLabel = (status: string) => {
    const labels = {
      pending: 'Pendiente',
      preparing: 'En preparación',
      ready: 'Listo',
    };
    return labels[status as keyof typeof labels];
  };

  return (
    <MainLayout title="Dashboard" subtitle="Vista general del restaurante">
      <div className="space-y-6">
        {/* Main Stats Grid */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {stats.map((stat) => (
            <Card key={stat.label} className={cn('border', stat.borderColor, stat.bgColor)}>
              <CardContent className="pt-6">
                <div className="flex items-center gap-4">
                  <div className={cn('p-3 rounded-xl', stat.bgColor)}>
                    <stat.icon className={cn('h-6 w-6', stat.color)} />
                  </div>
                  <div className="flex-1">
                    <p className="text-sm text-muted-foreground mb-1">{stat.label}</p>
                    <p className="text-3xl font-bold font-display">{stat.value}</p>
                    <p className="text-xs text-muted-foreground mt-1">{stat.change}</p>
                  </div>
                </div>
              </CardContent>
            </Card>
          ))}
        </div>

        {/* Secondary Stats */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {bottomStats.map((stat) => (
            <Card key={stat.label} className="gradient-card">
              <CardContent className="pt-6">
                <div className="flex items-center gap-4">
                  <div className={cn('p-3 rounded-xl', stat.bgColor)}>
                    <stat.icon className={cn('h-6 w-6', stat.color)} />
                  </div>
                  <div>
                    <p className="text-sm text-muted-foreground">{stat.label}</p>
                    <p className="text-2xl font-bold font-display">{stat.value}</p>
                    <p className="text-xs text-muted-foreground">{stat.subtext}</p>
                  </div>
                </div>
              </CardContent>
            </Card>
          ))}
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {/* Alertas Activas */}
          <Card className="border-destructive/30">
            <CardHeader>
              <div className="flex items-center gap-2">
                <AlertCircle className="h-5 w-5 text-destructive" />
                <CardTitle className="text-destructive">Alertas Activas</CardTitle>
              </div>
            </CardHeader>
            <CardContent className="space-y-3">
              <div className="p-3 rounded-lg bg-destructive/10 border border-destructive/20">
                <div className="flex items-center gap-2 mb-1">
                  <Badge variant="destructive" className="text-xs">Urgente</Badge>
                  <span className="text-sm font-bold">Mesa 12</span>
                </div>
                <p className="text-sm text-muted-foreground">Mesa lleva más de 60 minutos</p>
              </div>

              <div className="p-3 rounded-lg bg-warning/10 border border-warning/20">
                <div className="flex items-center gap-2 mb-1">
                  <Badge className="bg-warning text-warning-foreground text-xs">Info</Badge>
                  <span className="text-sm font-bold">Pedido Mesa 5</span>
                </div>
                <p className="text-sm text-muted-foreground">Preparación tardía (>15 min)</p>
              </div>

              <div className="p-3 rounded-lg bg-info/10 border border-info/20">
                <div className="flex items-center gap-2 mb-1">
                  <Badge className="bg-info text-info-foreground text-xs">Info</Badge>
                  <span className="text-sm font-bold">Ensalada César</span>
                </div>
                <p className="text-sm text-muted-foreground">Stock bajo - notificar compras</p>
              </div>
            </CardContent>
          </Card>

          {/* Pedidos Activos */}
          <Card className="lg:col-span-2">
            <CardHeader>
              <div className="flex items-center justify-between">
                <CardTitle>Pedidos Activos</CardTitle>
                <Link href="/orders">
                  <Button variant="outline" size="sm">Ver todos</Button>
                </Link>
              </div>
            </CardHeader>
            <CardContent className="space-y-3">
              {activeOrders.slice(0, 4).map(order => {
                const elapsedTime = getElapsedMinutes(order.createdAt);
                const hasAllergies = order.items.some(item => item.hasAllergies);

                return (
                  <div key={order.id} className="p-4 rounded-lg border border-border bg-card hover:bg-accent/10 transition-colors">
                    <div className="flex items-center justify-between">
                      <div className="flex items-center gap-4">
                        <div className="h-12 w-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary font-bold text-lg">
                          {order.tableNumber}
                        </div>
                        <div>
                          <div className="flex items-center gap-2">
                            <p className="font-display font-bold">Mesa {order.tableNumber}</p>
                            {hasAllergies && (
                              <Badge className="bg-destructive/10 text-destructive border-destructive/20 text-xs">
                                ⚠️ Alergia
                              </Badge>
                            )}
                            <Badge className={cn('status-badge text-xs', getStatusColor(order.status))}>
                              {getStatusLabel(order.status)}
                            </Badge>
                          </div>
                          <p className="text-sm text-muted-foreground">
                            {order.items.map(i => `${i.quantity}x ${i.menuItem.name}`).join(', ')}
                          </p>
                        </div>
                      </div>
                      <div className="text-right">
                        <p className="text-xl font-bold font-display text-primary">${order.total.toFixed(2)}</p>
                        <p className="text-xs text-muted-foreground flex items-center gap-1 justify-end">
                          <Clock className="h-3 w-3" />
                          {elapsedTime} min
                        </p>
                      </div>
                    </div>
                  </div>
                );
              })}
            </CardContent>
          </Card>
        </div>

        {/* Vista Rápida de Mesas */}
        <Card>
          <CardHeader>
            <div className="flex items-center justify-between">
              <CardTitle>Vista Rápida de Mesas</CardTitle>
              <Link href="/tables">
                <Button variant="outline" size="sm">Ver mapa completo</Button>
              </Link>
            </div>
          </CardHeader>
          <CardContent>
            <div className="flex items-center gap-2 mb-4 text-sm">
              <div className="flex items-center gap-2">
                <div className="w-3 h-3 rounded-full bg-success"></div>
                <span>Disponible</span>
              </div>
              <div className="flex items-center gap-2">
                <div className="w-3 h-3 rounded-full bg-primary"></div>
                <span>Ocupada</span>
              </div>
              <div className="flex items-center gap-2">
                <div className="w-3 h-3 rounded-full bg-warning"></div>
                <span>Limpiando</span>
              </div>
              <div className="flex items-center gap-2">
                <div className="w-3 h-3 rounded-full bg-info"></div>
                <span>Reservada</span>
              </div>
            </div>
            
            <div className="grid grid-cols-6 sm:grid-cols-8 md:grid-cols-10 lg:grid-cols-12 gap-2">
              {mockTables.map(table => {
                const bgColor = 
                  table.status === 'available' ? 'bg-success' :
                  table.status === 'occupied' ? 'bg-primary' :
                  table.status === 'reserved' ? 'bg-info' :
                  'bg-warning';
                
                return (
                  <div
                    key={table.id}
                    className={cn(
                      'aspect-square rounded-lg flex items-center justify-center text-white font-bold text-lg cursor-pointer hover:scale-110 transition-all',
                      bgColor
                    )}
                    title={`Mesa ${table.number} - ${table.status}`}
                  >
                    {table.number}
                  </div>
                );
              })}
            </div>
          </CardContent>
        </Card>
      </div>
    </MainLayout>
  );
}
