# Database
ConnectionStrings__DefaultConnection=Server=localhost;Database=SmartMenuDB;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True;

# Redis
ConnectionStrings__Redis=localhost:6379

# JWT Settings
JwtSettings__Secret=your-super-secret-key-minimum-32-characters-long-for-jwt-token-generation
JwtSettings__Issuer=SmartMenuAPI
JwtSettings__Audience=SmartMenuClient
JwtSettings__ExpirationMinutes=60

# Stripe
Stripe__SecretKey=sk_test_your_stripe_secret_key
Stripe__PublishableKey=pk_test_your_stripe_publishable_key
Stripe__WebhookSecret=whsec_your_webhook_secret

# DGII (República Dominicana)
DGII__RNC=131123456-7
DGII__RazonSocial=TU RESTAURANTE SRL
DGII__NombreComercial=Tu Restaurante
DGII__ApiUrl=https://ecf.dgii.gov.do/api
DGII__CertificatePath=certificates/dgii-cert.pfx
DGII__CertificatePassword=your-cert-password

# Environment
ASPNETCORE_ENVIRONMENT=Development
