HTML 200
}

# ─── Cliente final (customer-app, public PWA) ─────────────────────────────
# Tres maneras de acceder al PWA del cliente:
#   - qa.smartmenu.local:8443   (con hosts file en la PC)
#   - localhost:8451            (acceso local sin hosts file / MCP)
#   - 172.31.98.54:8443         (LAN IP — QR scannable desde el cell)
qa.smartmenu.local, localhost:8451, 172.31.98.54:8443 {
	tls internal
	encode gzip zstd
	# /api, /uploads, /hubs deben ir al backend (no a Next.js) porque sus
	# rewrites no toman process.env en runtime — y el cliente PWA hace fetch
	# a paths relativos.
	@apipath path /api/* /uploads/* /hubs/*
	reverse_proxy @apipath backend:8080
	reverse_proxy client-app:3000
}

# ─── Puertos localhost por app (para MCP/Chrome sin hosts file) ───────────
# Cada app accesible directo via https://localhost:84XX.
# Caddy enruta /api/*, /uploads/*, /hubs/* al backend directo porque las
# rewrites de Next.js no toman process.env en runtime con `next start`.
(app-with-backend) {
	tls internal
	encode gzip zstd
	@apipath path /api/* /uploads/* /hubs/*
	reverse_proxy @apipath backend:8080
}

localhost:8444 {
	import app-with-backend
	reverse_proxy admin-panel:3001
}

localhost:8445 {
	import app-with-backend
	reverse_proxy kds-app:3002
}

localhost:8446 {
	import app-with-backend
	reverse_proxy waiter-app:3003
}

localhost:8447 {
	import app-with-backend
	reverse_proxy host-app:3004
}

localhost:8448 {
	import app-with-backend
	reverse_proxy cashier-app:3005
}

localhost:8449 {
	import app-with-backend
	reverse_proxy reservation-app:3007
}

localhost:8450 {
	tls internal
	reverse_proxy backend:8080
	encode gzip zstd
}

# ─── Backend API + SignalR hubs ───────────────────────────────────────────
api.qa.smartmenu.local {
	tls internal
	# WebSockets / SSE para /hubs/*
	@hubs path /hubs/*
	reverse_proxy @hubs backend:8080 {
		header_up X-Forwarded-Proto {scheme}
	}
	reverse_proxy backend:8080 {
		header_up X-Forwarded-Proto {scheme}
		# Permite uploads grandes (imágenes de dishes ~10MB)
		transport http {
			read_buffer 8192
		}
	}
	encode gzip zstd
}

# ─── Staff apps ──────────────────────────────────────────────────────────
admin.qa.smartmenu.local {
	tls internal
	reverse_proxy admin-panel:3001
	encode gzip zstd
}

kds.qa.smartmenu.local {
	tls internal
	reverse_proxy kds-app:3002
	encode gzip zstd
}

waiter.qa.smartmenu.local {
	tls internal
	reverse_proxy waiter-app:3003
	encode gzip zstd
}

host.qa.smartmenu.local {
	tls internal
	reverse_proxy host-app:3004
	encode gzip zstd
}

cashier.qa.smartmenu.local {
	tls internal
	reverse_proxy cashier-app:3005
	encode gzip zstd
}

reservation.qa.smartmenu.local {
	tls internal
	reverse_proxy reservation-app:3007
	encode gzip zstd
}
