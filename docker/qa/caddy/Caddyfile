# SmartMenu QA â€” single Caddy con tls internal (Caddy auto-CA)
# Termina TLS para el browser; proxy HTTP plano a los contenedores.
#
# Hosts (agrega a tu hosts file â†’ 127.0.0.1):
#   qa.smartmenu.local
#   api.qa.smartmenu.local
#   admin.qa.smartmenu.local
#   kds.qa.smartmenu.local
#   waiter.qa.smartmenu.local
#   host.qa.smartmenu.local
#   cashier.qa.smartmenu.local
#   reservation.qa.smartmenu.local
#   delivery.qa.smartmenu.local
#
# Para que el browser no marque rojo, instala el root CA de Caddy:
#   docker exec smartmenu-qa-caddy cat /data/caddy/pki/authorities/local/root.crt > caddy-root.crt
#   (Windows) certutil -addstore -f Root caddy-root.crt

{
	# Caddy genera su propio CA local; se persiste en el volumen caddy-data.
	# Si quisieras emitir certs reales (Let's Encrypt) tendrÃ­as que cambiar a global email + hosts pÃºblicos.
	auto_https disable_redirects
	admin off
}

# QA-fix: emisor interno con certs de 90 dias (2160h) firmados directo por el root CA.
# Evita el ERR_CERT_DATE_INVALID que causaban los leaf de ~12h al quedar el stack inactivo.
# Se IMPORTA en TODOS los sitios; debe ser identico en todos para no crear politicas de
# certificado ambiguas para los hostnames compartidos (localhost / {$QA_LAN_IP}).
(tls-long) {
	tls {
		issuer internal {
			lifetime 2160h
			sign_with_root
		}
	}
}

# â”€â”€â”€ Security headers â€” aplica a TODOS los hosts vÃ­a snippet importado â”€â”€â”€â”€
(security-headers) {
	header {
		# HSTS: forzar HTTPS por 6 meses (browsers cachean esto). Solo aplica
		# cuando el server responde por HTTPS â€” sin includeSubDomains porque
		# el stack usa muchos subdomains nip.io y queremos opt-in per-cert.
		Strict-Transport-Security "max-age=15552000"
		# Bloquea iframe embedding desde otros sites (anti-clickjacking).
		X-Frame-Options "DENY"
		# Browsers no deben adivinar el content-type del response.
		X-Content-Type-Options "nosniff"
		# Permissions Policy â€” camera=(self) para QR scanner del waiter; resto bloqueado.
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		# Referrer mÃ­nimo en navegaciÃ³n cross-origin (no leak de paths internos).
		Referrer-Policy "strict-origin-when-cross-origin"
		# CSP relajado para QA (Next.js usa inline scripts/styles + necesita 'unsafe-eval'
		# en dev). Para producciÃ³n real, restringir aÃºn mÃ¡s.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' wss: https:; frame-ancestors 'none';"
		# Quita el header Server (info disclosure)
		-Server
	}
}

# â”€â”€â”€ HTTP catch-all â†’ HTTPS 8443 (cuando el browser olvida poner https://) â”€
# Container expone :80, mapeado a host :8080. Cualquier peticiÃ³n HTTP a localhost
# o *.qa.smartmenu.local se redirige al equivalente HTTPS en :8443.
http://localhost http://*.qa.smartmenu.local {
	redir https://{host}:8443{uri} 308
}

# â”€â”€â”€ HTTP plano vÃ­a LAN IP (legado â€” se queda como fallback) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
http://{$QA_LAN_IP} {
	encode gzip
	# CA raiz por HTTP PLANO (sin TLS) -> resuelve el problema del huevo y la
	# gallina: el device no confia en el sitio hasta instalar la CA, pero la CA
	# se descarga del propio sitio. Sirviendola sin TLS no hay advertencia.
	# Necesario para instalarla en un smartwatch/telefono Android o en iOS.
	handle /caddy-root-ca.crt {
		root * /srv/hub
		header Content-Type "application/x-x509-ca-cert"
		file_server
	}
	handle {
		@apipath path /api/* /uploads/* /hubs/*
		reverse_proxy @apipath backend:8080
		reverse_proxy client-app:3000
	}
}

# â”€â”€â”€ nip.io HTTPS â€” URLs limpias, accesibles desde cualquier device LAN â”€â”€â”€
# *.{$QA_LAN_NIP}.nip.io resuelve a {$QA_LAN_IP} sin tocar hosts file.
# Cert sigue siendo self-signed (Caddy CA local) â€” el cell mostrarÃ¡ warning
# una sola vez por hostname. Para evitar warning instala
# docker/qa/caddy-root-ca.crt en el cell, o usa Let's Encrypt con port
# forwarding 80/443 â†’ 8080/8443.

dev.{$QA_LAN_NIP}.nip.io, client.{$QA_LAN_NIP}.nip.io {
	import tls-long
	import security-headers
	encode gzip zstd
	@apipath path /api/* /uploads/* /hubs/*
	reverse_proxy @apipath backend:8080
	reverse_proxy client-app:3000
}

api.{$QA_LAN_NIP}.nip.io {
	import tls-long
	import security-headers
	encode gzip zstd
	reverse_proxy backend:8080
}

admin.{$QA_LAN_NIP}.nip.io {
