# â”€â”€â”€ Backend API + SignalR hubs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
api.qa.smartmenu.local {
	import tls-long
	import security-headers
	# WebSockets / SSE para /hubs/*
	@hubs path /hubs/*
	reverse_proxy @hubs backend:8080 {
		header_up X-Forwarded-Proto {scheme}
	}
	reverse_proxy backend:8080 {
		header_up X-Forwarded-Proto {scheme}
		# Permite uploads grandes (imÃ¡genes de dishes ~10MB)
		transport http {
			read_buffer 8192
		}
	}
	encode gzip zstd
}

