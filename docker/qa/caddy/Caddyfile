# â”€â”€â”€ Cliente final (customer-app, public PWA) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Tres maneras de acceder al PWA del cliente:
#   - qa.smartmenu.local:8443   (con hosts file en la PC)
#   - localhost:8451            (acceso local sin hosts file / MCP)
#   - {$QA_LAN_IP}:8451         (LAN IP â€” QR scannable desde el cell)
qa.smartmenu.local, localhost:8451, {$QA_LAN_IP}:8451 {
	import tls-long
	import security-headers
	encode gzip zstd
	# /api, /uploads, /hubs deben ir al backend (no a Next.js) porque sus
	# rewrites no toman process.env en runtime â€” y el cliente PWA hace fetch
	# a paths relativos.
	@apipath path /api/* /uploads/* /hubs/*
	reverse_proxy @apipath backend:8080
	reverse_proxy client-app:3000
}

# â”€â”€â”€ Puertos localhost por app (para MCP/Chrome sin hosts file) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Cada app accesible directo via https://localhost:84XX.
# Caddy enruta /api/*, /uploads/*, /hubs/* al backend directo porque las
# rewrites de Next.js no toman process.env en runtime con `next start`.
(app-with-backend) {
	import tls-long
	import security-headers
	encode gzip zstd
	@apipath path /api/* /uploads/* /hubs/*
	reverse_proxy @apipath backend:8080
}

localhost:8444, {$QA_LAN_IP}:8444 {
	import app-with-backend
	reverse_proxy admin-panel:3001
}

