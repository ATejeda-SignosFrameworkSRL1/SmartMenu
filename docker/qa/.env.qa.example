# SmartMenu QA — variables del stack docker compose
# Copia este archivo a `.env` (sin .example) y ajusta secretos.

# ===== SQL Server =====
SQL_SA_PASSWORD=CHANGEME_strong_sa_password
SQL_PID=Developer

# ===== JWT =====
# Mín 32 chars. En producción real cambia esto.
JWT_SECRET=CHANGEME_replace_with_32+_random_chars_0123456789abcd
JWT_ISSUER=SmartMenuAPI
JWT_AUDIENCE=SmartMenuClient
JWT_EXPIRATION_MIN=60

# ===== Stripe (test mode) =====
STRIPE_SECRET=sk_test_replace_me
STRIPE_PUBLISHABLE=pk_test_replace_me
STRIPE_WEBHOOK=whsec_replace_me

# ===== DGII (test) =====
DGII_RNC=131123456-7
DGII_RAZON_SOCIAL=QA RESTAURANTE SRL
DGII_NOMBRE_COMERCIAL=QA Restaurante

# ===== Caddy =====
# El root CA local de Caddy queda en el volumen caddy-data.
# Para que el browser confíe: instala /data/caddy/pki/authorities/local/root.crt
