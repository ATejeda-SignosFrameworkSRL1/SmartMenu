# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy solution and project files
COPY ["SmartMenu.sln", "./"]
COPY ["SmartMenu.API/SmartMenu.API.csproj", "SmartMenu.API/"]
COPY ["SmartMenu.Domain/SmartMenu.Domain.csproj", "SmartMenu.Domain/"]
COPY ["SmartMenu.Application/SmartMenu.Application.csproj", "SmartMenu.Application/"]
COPY ["SmartMenu.Infrastructure/SmartMenu.Infrastructure.csproj", "SmartMenu.Infrastructure/"]
COPY ["SmartMenu.Shared/SmartMenu.Shared.csproj", "SmartMenu.Shared/"]

# Restore dependencies
RUN dotnet restore "SmartMenu.API/SmartMenu.API.csproj"

# Copy everything else
COPY . .

# Build
WORKDIR "/src/SmartMenu.API"
RUN dotnet build "SmartMenu.API.csproj" -c Release -o /app/build

# Publish
FROM build AS publish
RUN dotnet publish "SmartMenu.API.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "SmartMenu.API.dll"]
